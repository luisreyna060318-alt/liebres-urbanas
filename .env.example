# Copia este archivo a ".env" y cambia los valores. El archivo ".env" real NUNCA se sube a Git.
# Todos los valores de abajo son de ejemplo: no son secretos reales. Las contraseñas de las cuentas de
# demostración son ficticias y públicas (aparecen también en el README); no uses aquí contraseñas tuyas.

# --- Base de datos (PostgreSQL en Docker Compose) ---
# Evita caracteres especiales (@ : / ? #) en la contraseña: Compose la mete dentro de DATABASE_URL.
POSTGRES_USER=liebre_urbana
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=liebre_urbana
# Puerto de TU computadora donde Docker publica PostgreSQL (solo en 127.0.0.1). Si ya tienes un PostgreSQL local
# usando el 5432 y "docker compose up" falla, descomenta y cambia a un puerto libre. Dentro de Docker no cambia nada.
# DB_HOST_PORT=5433

# --- Backend (FastAPI) ---
# Con Docker Compose, DATABASE_URL se arma sola con las variables POSTGRES_* de arriba.
# Solo la defines tú si corres el backend FUERA de Docker (por ejemplo en tu .venv) o en la nube (Render + Neon):
#   postgresql+psycopg://usuario:contrasena@host/basedatos        (Neon: agrega ?sslmode=require)
# DATABASE_URL=postgresql+psycopg://liebre_urbana:cambia-esta-contrasena@127.0.0.1:5432/liebre_urbana

# "desarrollo" o "produccion". En producción el backend NO arranca con la SECRET_KEY de este ejemplo.
ENTORNO=desarrollo
# Genera una clave larga y aleatoria, por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
# Origen(es) del frontend permitidos por CORS, separados por comas. No usar "*".
# 8080 es el frontend de Docker Compose; 5173 es el de "npm run dev".
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) ---
# URL de la API que usa el NAVEGADOR. En Docker Compose se escribe en el código al construir la imagen del
# frontend: si la cambias, vuelve a correr "docker compose up --build".
VITE_API_URL=http://localhost:8000

# --- Datos de demostración (semilla) ---
# SEED_ON_START=true: al arrancar el backend se cargan los datos ficticios si la base está vacía.
SEED_ON_START=true
# Una cuenta por rol. Los correos son opcionales (si no los defines, la semilla usa los suyos @liebreurbana.test).
# Solo para desarrollo: en producción define contraseñas distintas a estas de ejemplo.
SEED_CIUDADANO_CORREO=ciudadano@liebreurbana.test
SEED_CIUDADANO_PASSWORD=Demo-Ciudadano-2026
SEED_MODERADOR_CORREO=moderador@liebreurbana.test
SEED_MODERADOR_PASSWORD=Demo-Moderador-2026
SEED_COORDINADOR_CORREO=coordinador@liebreurbana.test
SEED_COORDINADOR_PASSWORD=Demo-Coordinador-2026
